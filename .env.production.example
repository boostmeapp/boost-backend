# ==============================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================
# Copy this file to .env.production and fill in your production values
# NEVER commit .env.production to version control!

# Environment
NODE_ENV=production

# Server
PORT=3000

# Database - MongoDB (Production with Replica Set)
# Use connection string with proper options for production
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/boostme?retryWrites=true&w=majority&maxPoolSize=100&minPoolSize=10&serverSelectionTimeoutMS=5000&socketTimeoutMS=45000

# JWT Configuration
# IMPORTANT: Generate strong secrets using: openssl rand -base64 64
JWT_SECRET=CHANGE_THIS_TO_STRONG_SECRET_64_CHARS_MIN
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=CHANGE_THIS_TO_DIFFERENT_STRONG_SECRET_64_CHARS_MIN
JWT_REFRESH_EXPIRES_IN=30d

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# API Configuration
API_PREFIX=api
API_VERSION=v1

# AWS S3 Configuration
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
AWS_S3_BUCKET=boostme-production
AWS_CLOUDFRONT_DOMAIN=d1234567890.cloudfront.net

# Video Processing
VIDEO_CHUNK_DURATION=4
VIDEO_QUALITIES=360p,720p,1080p

# Stripe (Production Keys)
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# Redis Configuration (Production with Sentinel/Cluster)
REDIS_HOST=redis-production.yourdomain.com
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_REDIS_PASSWORD
REDIS_DB=0

# Redis Connection Pool
REDIS_MAX_CONNECTIONS=20
REDIS_MIN_CONNECTIONS=5

# BullMQ Configuration
BULL_REDIS_HOST=redis-queue.yourdomain.com
BULL_REDIS_PORT=6379
BULL_REDIS_PASSWORD=YOUR_BULL_REDIS_PASSWORD

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
THROTTLE_AUTH_LIMIT=5

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Application Monitoring (Optional - Add your providers)
# SENTRY_DSN=https://your-sentry-dsn
# NEW_RELIC_LICENSE_KEY=your-new-relic-key
# DATADOG_API_KEY=your-datadog-key

# Health Check
HEALTH_CHECK_ENABLED=true

# Payment Processing
MINIMUM_PAYOUT_AMOUNT=20
PAYOUT_SCHEDULE_CRON=0 9 * * 1

# Security
MAX_REQUEST_SIZE=50mb
BCRYPT_ROUNDS=12

MAIL_PROVIDER=brevo

SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
MAIL_FROM=BoostMe <no-reply@yourdomain.com>

BREVO_API_KEY=your-brevo-v3-api-key
BREVO_SENDER_EMAIL=no-reply@yourdomain.com
BREVO_SENDER_NAME=BoostMe
APP_NAME=BoostMe
FRONTEND_URL=https://app.yourdomain.com
APP_DEEP_LINK_SCHEME=boostra

# ──────────────────────────────────────────────────────────────
# Push notifications (Firebase Cloud Messaging)
# Values come from a Firebase service account JSON:
#   Firebase console → Project settings → Service accounts
#   → Generate new private key
# Map the JSON fields as:
#   project_id   → FIREBASE_PROJECT_ID
#   client_email → FIREBASE_CLIENT_EMAIL
#   private_key  → FIREBASE_PRIVATE_KEY
# Keep the private key on ONE line, with the \n sequences left as
# literal backslash-n, and wrap the whole value in double quotes.
# Leave these blank to run with push disabled — everything else works.
# ──────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# Redis — the notification queue runs on this
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Set to 1 for managed Redis that requires TLS
REDIS_TLS=0

# ──────────────────────────────────────────────────────────────
# Video calling (Stream Video)
# dashboard.getstream.io → your app → Overview → App Access Keys.
# Use a separate Stream app for dev and production.
# Production refuses to boot if the key or secret is missing;
# other environments boot with calling disabled.
# STREAM_API_SECRET is server-only — never ship it to the app.
# ──────────────────────────────────────────────────────────────
STREAM_API_KEY=
STREAM_API_SECRET=
STREAM_APP_ID=
# Push provider NAMES as created in the Stream dashboard (see
# docs/video-calling-push-runbook.md). Defaults shown; set only if yours differ.
# The APNs provider is chosen per app build, not per backend:
#   development builds → SANDBOX; staging / TestFlight / App Store → PRODUCTION.
STREAM_APN_PROVIDER_SANDBOX=boostra-voip-dev
STREAM_APN_PROVIDER_PRODUCTION=boostra-voip-prod
STREAM_FIREBASE_PROVIDER=boostra-android
# Stream → backend webhook (POST /api/calls/webhook). false = verify, log and
# acknowledge, but never change call records (for staging on a shared app).
STREAM_WEBHOOK_ENABLED=true
# Seconds a call rings before it becomes "missed" (default 45).
CALL_RING_TIMEOUT_SECONDS=45
# Per-caller cap on calls started in any rolling hour (default 30).
CALL_MAX_PER_HOUR=30
# Hourly answer rate below this fraction logs "ALERT call answer rate ..." at
# error level — point log-based alerting at it (default 0.4).
CALL_ANSWER_RATE_ALERT_FLOOR=0.4
# Calling feature flag. Unset = OFF in production, ON elsewhere (ship dark).
# While off, only these user ids (comma-separated) can call.
CALLING_ENABLED=false
CALLING_ROLLOUT_USER_IDS=
# The PRODUCTION Stream app's id — set in EVERY environment. Boot refuses a
# non-production backend on the production app, and production on any other.
STREAM_PRODUCTION_APP_ID=
# Stream plan's monthly participant-minute limit; enables the 70% usage alert.
CALL_MONTHLY_PARTICIPANT_MINUTES_ALLOWANCE=
